# ARGUS Infrastructure Environment Variables Example
# Copy to .env and replace placeholders with local development values.
# Never commit your actual .env file.
# Server Settings
PORT=8000
HOST=127.0.0.1
ENV=development
DEBUG=False
SECRET_KEY=replace-with-a-random-local-development-secret
# AI / LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gpt-4o
# Database Configuration (PostgreSQL)
POSTGRES_USER=argus_user
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=argus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://argus_user:replace-with-a-local-postgres-password@localhost:5432/argus_db
# Graph Database Configuration (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-neo4j-password
# Vector Database Configuration (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# Storage & File Paths
EVIDENCE_STORAGE_PATH=./data/evidence
SYNTHETIC_DATA_PATH=./data/synthetic
